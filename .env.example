# Copy this file to .env (in this same folder) and fill in the values.
# Never commit the real .env: it is listed in .gitignore.

# --- AI model, routed through the course Portkey gateway ---
PORTKEY_API_KEY=
PORTKEY_BASE_URL=https://api.portkey.ai/v1
OPENAI_MODEL=gpt-6-astra

# --- Login sessions ---
# A long random string that signs login cookies. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Set to true only when the site is served over HTTPS.
COOKIE_SECURE=false

# --- Optional ---
# PBKDF2 iterations used for the course data pack's sample users (defaults to 120000).
PBKDF2_LEGACY_ITERATIONS=
# Where to find the data pack's database (defaults to data/campus_customs.db).
CAMPUS_DB_PATH=
# Hide PydanticAI's startup banner in the server log.
PYDANTIC_AI_NO_BANNER=1
